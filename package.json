{
  "name": "projectatlas",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:generate": "node scripts/generate-country-data.mjs",
    "data:sources:update": "node scripts/update-source-snapshots.mjs",
    "data:verify": "node scripts/verify-generated-data.mjs",
    "data:regions:sources:update": "node scripts/update-admin1-source.mjs",
    "data:regions:reconcile": "node scripts/reconcile-region-source.mjs",
    "data:regions:confirm-new": "node scripts/confirm-new-region-identity.mjs",
    "data:regions:generate": "node scripts/generate-region-data.mjs",
    "data:adjacency:generate": "node scripts/build-adjacency.mjs",
    "data:regions:verify": "node scripts/verify-region-data.mjs",
    "data:population:sources:extract": "node scripts/extract-wpp-population.mjs",
    "data:population:generate": "node scripts/generate-population-data.mjs",
    "data:population:rebuild": "node scripts/rebuild-population-spatial.mjs",
    "data:population:verify": "node scripts/verify-population-data.mjs",
    "data:economy:generate": "node scripts/generate-economic-data.mjs",
    "data:economy:verify": "node scripts/verify-economic-data.mjs",
    "data:audit:generate": "node scripts/audit-data.mjs --write",
    "data:audit": "npm run data:verify && npm run data:regions:verify && npm run data:population:verify && npm run data:economy:verify && node scripts/audit-data.mjs && node scripts/military-audit.mjs && node scripts/trade-audit.mjs",
    "test": "vitest run",
    "benchmark:world": "vitest run src/simulation/__tests__/worldBenchmark.test.ts --reporter=verbose",
    "verify": "npm run data:audit && npm run build && npm test",
    "economy:audit": "node scripts/socioeconomic-audit.mjs",
    "economy:audit:generate": "node scripts/socioeconomic-audit.mjs --write",
    "fiscal:audit": "node scripts/fiscal-audit.mjs",
    "fiscal:audit:generate": "node scripts/fiscal-audit.mjs --write",
    "crisis:audit": "vitest run src/simulation/__tests__/crisis.test.ts --reporter=verbose",
    "crisis:benchmark": "vitest run src/simulation/__tests__/crisisWorld.test.ts --reporter=verbose",
    "politics:audit": "node scripts/politics-audit.mjs",
    "politics:audit:generate": "node scripts/politics-audit.mjs --write",
    "politics:sources:update": "node scripts/update-politics-source.mjs",
    "politics:data:generate": "node scripts/generate-politics-data.mjs",
    "politics:benchmark": "vitest run src/simulation/__tests__/politicsWorld.test.ts --reporter=verbose",
    "governance:audit": "vitest run src/simulation/__tests__/governance.test.ts --reporter=verbose",
    "governance:benchmark": "vitest run src/simulation/__tests__/governanceWorld.test.ts --reporter=verbose",
    "information:audit": "node scripts/party-leader-audit.mjs",
    "information:audit:generate": "node scripts/party-leader-audit.mjs --write",
    "information:test": "vitest run src/simulation/__tests__/information.test.ts --reporter=verbose",
    "information:benchmark": "vitest run src/simulation/__tests__/informationWorld.test.ts --reporter=verbose",
    "military:audit": "node scripts/military-audit.mjs && vitest run src/simulation/__tests__/military.test.ts --maxWorkers=1",
    "military:benchmark": "vitest run src/simulation/__tests__/militaryWorld.test.ts --maxWorkers=1 --reporter=verbose",
    "trade:audit": "node scripts/trade-audit.mjs && vitest run src/simulation/__tests__/trade.test.ts --maxWorkers=1",
    "trade:benchmark": "vitest run src/simulation/__tests__/tradeWorld.test.ts --maxWorkers=1 --reporter=verbose",
    "international:audit": "vitest run src/simulation/__tests__/international.test.ts --maxWorkers=1",
    "international:benchmark": "vitest run src/simulation/__tests__/internationalBenchmark.test.ts --maxWorkers=1 --reporter=verbose",
    "operations:audit": "node scripts/operations-audit.mjs && vitest run src/simulation/__tests__/operations.test.ts --maxWorkers=1",
    "multilateral:audit": "node scripts/multilateral-audit.mjs && vitest run src/simulation/__tests__/multilateral.test.ts --maxWorkers=1",
    "multilateral:benchmark": "vitest run src/simulation/__tests__/multilateralBenchmark.test.ts --maxWorkers=1 --reporter=verbose",
    "v1:endurance": "vitest run src/simulation/__tests__/v1Endurance.test.ts --maxWorkers=1",
    "v1:audit": "npm run data:audit && npm run military:audit && npm run trade:audit && npm run international:audit && npm run operations:audit && npm run multilateral:audit && npm run v1:endurance",
    "trade:data:generate": "node scripts/trade-audit.mjs --write",
    "trade:sources:update": "node scripts/update-trade-source.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waffle913/ProjectAtlas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/waffle913/ProjectAtlas/issues"
  },
  "homepage": "https://github.com/waffle913/ProjectAtlas#readme",
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mapshaper": "0.7.68",
    "vitest": "^5.0.2"
  }
}
