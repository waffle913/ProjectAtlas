    "@vitejs/plugin-react": "^6.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mapshaper": "0.7.68",
    "vitest": "^5.0.2"
  }
